{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tx",
  "version": "0.2.1",
  "identifier": "com.jrydel.tx",
  "mainBinaryName": "tx-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tx",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://i.ytimg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "TL;DRs of new videos from channels you follow",
    "longDescription": "tx watches YouTube channels you pick, transcribes new uploads, and scores each one against a description of what you want to learn, with a TL;DR, takeaways and timestamps.",
    "copyright": "Jiří Rýdel",
    "externalBin": ["binaries/yt-dlp", "binaries/qjs", "binaries/tx"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] },
      "rpm": { "depends": ["libayatana-appindicator-gtk3"] }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
